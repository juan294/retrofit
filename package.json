{
  "name": "retrofit",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3009",
    "build": "next build",
    "start": "next start --port 3010",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --reporter=default --reporter=json --outputFile.json=.local/evidence/current/vitest-unit.json",
    "test:coverage": "vitest run --project unit --coverage --reporter=default",
    "test:perf": "vitest run --project perf --no-file-parallelism --reporter=default --reporter=json --outputFile.json=.local/evidence/current/vitest-perf.json",
    "test:e2e": "playwright test",
    "vendor:sync": "node tools/vendor-agentic-web.mjs sync --source .local/vendor/agentic-web --commit 05165377aca457381bd41b5c05e7a26cd23e6d74",
    "vendor:verify": "node tools/vendor-agentic-web.mjs verify",
    "evidence:begin": "node tools/evidence.mjs begin",
    "evidence:seal": "node tools/evidence.mjs seal",
    "agent:build": "node tools/agentic-web/scripts/build_network.mjs agent/retrofit_guide.hocon --manifest public/agent-manifest.json --runtime tools/agentic-web/runtime --out public/retrofit_guide.network.json && node tools/agentic-web/scripts/build_network.mjs agent/retrofit_conformance.hocon --runtime tools/agentic-web/runtime --out public/retrofit_conformance.network.json",
    "agent:check": "node tools/agentic-web/scripts/build_network.mjs agent/retrofit_guide.hocon --manifest public/agent-manifest.json --runtime tools/agentic-web/runtime --out public/retrofit_guide.network.json --check && node tools/agentic-web/scripts/build_network.mjs agent/retrofit_conformance.hocon --runtime tools/agentic-web/runtime --out public/retrofit_conformance.network.json --check",
    "ops:resume-free": "node tools/ops/resume-free.mjs",
    "peer:build": "node tools/agentic-web/scripts/build_network.mjs peers/demo-harbor/agent/harbor_tours.hocon --manifest peers/demo-harbor/public/agent-manifest.json --runtime tools/agentic-web/runtime --out peers/demo-harbor/public/harbor_tours.network.json && node tools/agentic-web/scripts/build_network.mjs peers/demo-harbor/agent/harbor_loop.hocon --runtime tools/agentic-web/runtime --out peers/demo-harbor/public/harbor_loop.network.json",
    "peer:check": "node tools/agentic-web/scripts/build_network.mjs peers/demo-harbor/agent/harbor_tours.hocon --manifest peers/demo-harbor/public/agent-manifest.json --runtime tools/agentic-web/runtime --out peers/demo-harbor/public/harbor_tours.network.json --check && node tools/agentic-web/scripts/build_network.mjs peers/demo-harbor/agent/harbor_loop.hocon --runtime tools/agentic-web/runtime --out peers/demo-harbor/public/harbor_loop.network.json --check",
    "evidence:analyze": "node tools/release/analyze-evidence.mjs",
    "test:db": "node tools/gate-db.mjs",
    "gate-db:recover": "node tools/gate-db.mjs recover",
    "evidence:production": "node tools/release/production-evidence.mjs",
    "test:e2e-prod": "playwright test --config e2e-prod/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "cheerio": "1.2.0",
    "ipaddr.js": "2.5.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "robots-parser": "3.0.1",
    "stripe": "23.2.0",
    "tldts": "7.4.28",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
